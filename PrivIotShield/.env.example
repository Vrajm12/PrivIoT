# ==============================================================================
# PRIVIOT SHIELD — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace_with_cryptographically_secure_random_hex_key_64_bytes

# Authoritative Database (PostgreSQL 16)
DATABASE_URL=postgresql://priviot_app_user:replace_with_db_password@postgres.internal:5432/priviot_shield_db

# Cache, Event Bus & Task Broker (Redis 7)
REDIS_URL=redis://:replace_with_redis_password@redis.internal:6379/0

# Celery Asynchronous Workers
CELERY_BROKER_URL=redis://:replace_with_redis_password@redis.internal:6379/0
CELERY_RESULT_BACKEND=redis://:replace_with_redis_password@redis.internal:6379/0

# API & Security Boundaries
API_BASE_URL=https://soc.priviot.internal
ALLOWED_HOSTS=soc.priviot.internal,api.priviot.internal
CORS_ORIGINS=https://soc.priviot.internal

# Threat Intelligence & Integrations (Optional)
CISA_KEV_FEED_ENABLED=true
EPSS_FEED_ENABLED=true
OPENAI_API_KEY=

# Commercial Stripe Webhook (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
